    "import numpy as np\n",
    "vector_row = np.array([1, 2, 3])\n",
    "print(\"Row Vector:\")\n",
    "print(vector_row)\n",
    "vector_column = vector_row[:, np.newaxis]\n",
    "print(\"\\nColumn Vector:\")\n",
    "print(vector_column)\n",
    "print(\"\\nShape of Row Vector:\", vector_row.shape)\n",
    "print(\"Shape of Column Vector:\", vector_column.shape)"
