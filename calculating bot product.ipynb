   "source": [
    "import numpy as np\n",
    "\n",
    "# Create two vectors\n",
    "A = np.array([1, 2, 3])\n",
    "B = np.array([4, 5, 6])\n",
    "\n",
    "# Calculate dot product\n",
    "dot_product = np.dot(A, B)\n",
    "\n",
    "print(\"Vector A:\", A)\n",
    "print(\"Vector B:\", B)\n",
    "print(\"Dot product:\", dot_product)"
   ]
