   "source": [
    "import pandas as pd\n",
    "\n",
    "# Create dataset\n",
    "data = {\n",
    "    \"Name\": [\"Sukumar\", \"Rahul\", \"Kiran\", \"Arjun\"],\n",
    "    \"Age\": [22, 23, 21, 24],\n",
    "    \"Marks\": [85, 78, 92, 65]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "# Sort by Marks in ascending order\n",
    "result = df.sort_values(\"Marks\")\n",
    "\n",
    "print(result)"
   ]
