   "source": [
    "  # Trace of a matrix\n",
    "\n",
    "matrix = [\n",
    "    [1, 2, 3],\n",
    "    [4, 5, 6],\n",
    "    [7, 8, 9]\n",
    "]\n",
    "\n",
    "trace = 0\n",
    "\n",
    "for i in range(len(matrix)):\n",
    "    trace = trace + matrix[i][i]\n",
    "\n",
    "print(\"Trace of the matrix:\", trace)"
   ]
