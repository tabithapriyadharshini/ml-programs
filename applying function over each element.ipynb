   ],
   "source": [
    "import numpy as np\n",
    "matrix = np.array([\n",
    "    [1, 2],\n",
    "    [3, 4]\n",
    "])\n",
    "def add_100(x):\n",
    "    return x + 100\n",
    "vectorized_add_100 = np.vectorize(add_100)\n",
    "result = vectorized_add_100(matrix)\n",
    "print(\"Original Matrix:\")\n",
    "print(matrix)\n",
    "print(\"\\nMatrix after adding 100:\")\n",
    "print(result)"
   ]
  },
